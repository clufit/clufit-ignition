# Copy to .env.local and fill in. Also add these to Netlify site env vars (Site
# configuration -> Environment variables) for production, then redeploy.

# Neon DB connection, provisioned via Netlify's DB extension.
# Get it with `netlify env:get NETLIFY_DB_URL` or from the Netlify dashboard.
# Note: the variable name is NETLIFY_DB_URL (not NETLIFY_DATABASE_URL).
NETLIFY_DB_URL=

# Admin backend (/admin) auth.
ADMIN_PASSWORD=
# Random 32+ char string used to encrypt the admin session cookie.
ADMIN_SESSION_SECRET=

# Google Analytics 4. VITE_GA_MEASUREMENT_ID is public (shipped to the browser,
# like every GA measurement ID) -- the rest are the service-account credentials
# used server-side to read traffic into the admin dashboard via the GA4 Data API.
VITE_GA_MEASUREMENT_ID=
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=
